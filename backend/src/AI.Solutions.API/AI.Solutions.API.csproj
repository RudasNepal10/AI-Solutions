    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AI.Solutions.Application\AI.Solutions.Application.csproj" />
    <ProjectReference Include="..\AI.Solutions.Infrastructure\AI.Solutions.Infrastructure.csproj" />
